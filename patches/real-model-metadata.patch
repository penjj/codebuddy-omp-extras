+export type RawCreditRates = Map<string, number>;
+
+type RawModelLike = {
+	id?: string;
+	value?: string;
+	maxInputTokens?: number | null;
+	maxOutputTokens?: number | null;
+	credits?: string | number | null;
+	supportsImages?: boolean;
+	supportsToolCall?: boolean;
+	supportsReasoning?: boolean;
