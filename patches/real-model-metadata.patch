+/** Parse a credits multiplier such as "x0.51 credits" or "0.51" into 0.51. */
+export function parseCreditsRate(raw: string | number | null | undefined): number | undefined {
+	if (typeof raw === "number") return Number.isFinite(raw) && raw >= 0 ? raw : undefined;
+	if (typeof raw !== "string") return undefined;
+	// Matches "x2.00 credits", "2.00", "x0.51" — first number in the string.
+	const match = raw.match(/(\d+(?:\.\d+)?)/);
+	if (!match) return undefined;
+	const value = Number.parseFloat(match[1]);
+	return Number.isFinite(value) && value >= 0 ? value : undefined;
+}
+
+/** Index the credits multiplier for every model, matched as loosely as token limits. */
+export function indexRawCreditRates(raw: RawModelLike[] | undefined): RawCreditRates {
+	const out: RawCreditRates = new Map();
+	if (!Array.isArray(raw)) return out;
+	for (const m of raw) {
+		const rate = parseCreditsRate(m.credits);
+		if (rate === undefined) continue;
+		for (const key of [m.id, m.value, String(m.id ?? m.value ?? "").split("/").pop()]) {
+			if (key) out.set(key.toLowerCase(), rate);
+		}
+	}
+	return out;
+}
