+		// so both spellings resolve regardless of which form the CLI used.
+		for (const key of [m.id, m.value, String(m.id ?? m.value ?? "").split("/").pop()]) {
+			if (key) out.set(key.toLowerCase(), entry);
+		}
+	}
+	return out;
