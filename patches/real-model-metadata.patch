+const PI_THINKING_LEVELS = ["minimal", "low", "medium", "high", "xhigh", "max"] as const;
+const EFFORT_ORDER = ["low", "medium", "high", "max"] as const;
+// Ordinal position of each pi level on the same scale.
+const PI_EFFORT_RANK: Record<string, number> = {
