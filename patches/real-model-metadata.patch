+/** Index raw CLI/SDK model metadata by every identifier it answers to. */
+export function indexRawTokenLimits(raw: RawModelLike[] | undefined): RawTokenLimits {
+	const out: RawTokenLimits = new Map();
+	if (!Array.isArray(raw)) return out;
+	for (const m of raw) {
+		const contextWindow = typeof m.maxInputTokens === "number" && m.maxInputTokens > 0 ? m.maxInputTokens : undefined;
+		const maxTokens = typeof m.maxOutputTokens === "number" && m.maxOutputTokens > 0 ? m.maxOutputTokens : undefined;
